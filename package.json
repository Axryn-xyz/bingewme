{
  "name": "binge-w-me",
  "description": "No-signup watch rooms with synchronized playback, live chat, annotations, and adaptive color themes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/havioo/bingewme.git"
  },
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/index.js\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "cheerio": "^1.2.0",
    "emoji-picker-react": "^5.1.4",
    "express": "^4.21.2",
    "hls.js": "^1.7.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
