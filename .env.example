# The HTTP and Socket.io server share this port.
PORT=3001

# Optional: live GIF searches. Leave empty for the curated starter picker.
GIPHY_API_KEY=

# Optional: separate room server when the frontend is hosted on Vercel.
# This URL is public and is read at build time. Leave blank for single-service hosting.
VITE_ROOM_SERVER_URL=

# On the room server: exact allowed frontend origins, separated by commas.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
FRONTEND_ORIGINS=

# Maximum room upload size in bytes (default 10 GiB). Provider body/disk limits also apply.
MAX_UPLOAD_BYTES=10737418240
